azure_location      = "westeurope"
name_prefix         = "fl-poc"
vm_size             = "Standard_B1s"
admin_username      = "fladmin"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
ssh_cidr            = "YOUR.PUBLIC.IP.ADDR/32"

