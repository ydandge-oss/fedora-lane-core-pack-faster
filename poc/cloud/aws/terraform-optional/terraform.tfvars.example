aws_region    = "us-east-1"
name_prefix   = "fl-poc"
instance_type = "t3.small"
key_name      = "YOUR_EC2_KEY_PAIR_NAME"
ssh_cidr      = "YOUR.PUBLIC.IP.ADDR/32"

# Optional overrides:
# ami_id = "ami-xxxxxxxx"
# For RHEL-compatible practice without Marketplace:
# ami_owners      = ["679593333241"]
# ami_name_filter = "Rocky-9*x86_64*"
