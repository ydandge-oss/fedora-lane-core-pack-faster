# Copy to poc/cloud/aws/env.local (gitignored) and fill in.
#   cp poc/cloud/aws/env.example poc/cloud/aws/env.local

AWS_REGION=us-east-1
INSTANCE_TYPE=t3.small
NAME_TAG=fl-poc-aws-ecom

# Existing EC2 key pair name in that region
KEY_NAME=YOUR_EC2_KEY_PAIR_NAME

# Path to the matching private key on your laptop (for SSH later)
SSH_PRIVATE_KEY=~/.ssh/your-aws-key.pem

# RHEL on AWS usually logs in as ec2-user
SSH_USER=ec2-user

# Your public IP as x.x.x.x/32 — do NOT use 0.0.0.0/0 for long-lived demos
SSH_CIDR=YOUR.PUBLIC.IP.ADDR/32

# Optional: pin a specific AMI. Leave empty to auto-find latest RHEL 9 Hourly.
AMI_ID=

# Optional: subnet / VPC. Leave empty to use default VPC.
SUBNET_ID=
VPC_ID=
