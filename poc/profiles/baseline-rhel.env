# Target state from Image Builder blueprint fl-rhel-baseline
FL_SITE=any
FL_ROLE=standard_rhel
FL_OS=RHEL 9 (golden image)
FL_NTP=chrony (time.google.com, time.cloudflare.com)
FL_FIREWALL=firewalld (22/tcp, 8080/tcp)
FL_INSIGHTS=insights-client enabled
FL_ADMIN_USER=fladmin
FL_APP_RUNTIME=podman or python3 on baseline
FL_NOTES=Born from Git-tracked blueprint — same for VA, Frankfurt, boutique, cloud
